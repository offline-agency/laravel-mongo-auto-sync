{
    "name": "offline-agency/laravel-mongo-auto-sync",
    "description": "This package provides a better support for MongoDB relationships in Laravel Projects.",
    "type": "library",
    "keywords": ["laravel","database","mongodb","eloquent", "relationships"],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-mongodb": "*",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/events": "^12.0|^13.0",
        "mongodb/laravel-mongodb": "^5.6"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpcov": "^11.0|^12.0|^13.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Offline Agency",
            "email": "info@offlineagency.it"
        }
    ],
    "autoload": {
        "psr-4": {
            "OfflineAgency\\MongoAutoSync\\": "src/"
        },
        "files": [
            "src/syncUtils.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "files": [
            "src/syncUtils.php"
        ]
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "OfflineAgency\\MongoAutoSync\\MongoAutoSyncServiceProvider"
            ]
        }
    }
}
